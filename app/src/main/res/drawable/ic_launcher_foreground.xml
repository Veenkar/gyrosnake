<?xml version="1.0" encoding="utf-8"?>
<!-- Retro pixel-snake foreground for the adaptive launcher icon -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Snake body segments (horizontal, centred) -->
    <path android:fillColor="#00CC33"
        android:pathData="M20,50 h10 v10 h-10 z
                         M32,50 h10 v10 h-10 z
                         M44,50 h10 v10 h-10 z
                         M56,50 h10 v10 h-10 z" />

    <!-- Snake head (slightly larger, brighter) -->
    <path android:fillColor="#00FF55"
        android:pathData="M68,46 h14 v18 h-14 z" />

    <!-- Eyes -->
    <path android:fillColor="#0D2B0D"
        android:pathData="M70,49 h3 v3 h-3 z
                         M77,49 h3 v3 h-3 z" />

    <!-- Food pellet -->
    <path android:fillColor="#FF4400"
        android:pathData="M30,30 h10 v10 h-10 z" />
</vector>
