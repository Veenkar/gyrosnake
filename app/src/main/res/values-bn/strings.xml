    <string name="scheme_gravity_label">হেলানো (গ্র্যাভিটি)</string>
    <string name="scheme_gravity_desc">সমতল ধরুন, চালাতে হেলান\nফোনটি টেবিলে রাখুন, স্ক্রিন উপরের দিকে</string>
