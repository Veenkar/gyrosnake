    <string name="scheme_overlay_label">虚拟摇杆</string>
    <string name="scheme_overlay_desc">屏幕上的虚拟摇杆</string>
    <string name="scheme_flick_label">甩动（陀螺仪）</string>
    <string name="scheme_flick_desc">甩动手腕即可转向</string>
    <string name="scheme_gravity_label">倾斜（重力感应）</string>
    <string name="scheme_gravity_desc">平放手机，倾斜以操控\n将手机放在桌上，屏幕朝上</string>
