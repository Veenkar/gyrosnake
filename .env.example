# Copy to .env and adjust. .env is gitignored; never commit it.
# No spaces around '=', no surrounding quotes.

# JDK used by Gradle (Android Studio's bundled JBR).
JAVA_HOME=C:\Program Files\Android\Android Studio\jbr

# Play Store signing.
KEYSTORE=C:\Users\you\Documents\android_key\yourkeystore
KEY_ALIAS=your_key_alias

# Optional: signing passwords. Leave unset to be prompted instead.
# Storing them here keeps the plaintext on disk — only do it on a machine you trust.
#STORE_PASS=
#KEY_PASS=

# Application id, used by the flash scripts to launch the app.
APP_ID=com.gyrosnake
